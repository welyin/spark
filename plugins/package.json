  "description": "Spark 插件源码与打包发布工具（市场链路见 README.md）",
  "scripts": {
    "build:example": "node ../app/node_modules/vite/bin/vite.js build --config spark-example/vite.config.ts && node scripts/copy-example-dist.mjs",
