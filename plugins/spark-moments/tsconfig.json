{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "vue": ["../../app/node_modules/vue/dist/vue.d.ts"],
      "element-plus": ["../../app/node_modules/element-plus/es/index.d.ts"],
      "vitest": ["../../app/node_modules/vitest/dist/index.d.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.d.ts", "**/*.vue", "vite.config.ts"]
}
