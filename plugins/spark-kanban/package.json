{
  "name": "@spark/plugin-spark-kanban",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "任务看板插件（自举）：开发任务与缺陷的看板跟踪——原生卡片操作流 + 子事务绑定卡片（状态操作入事务日志，档三-1），可独立安装亦可作为库被「项目」插件组合。",
  "scripts": {
    "build": "node ../../app/node_modules/vite/bin/vite.js build --config vite.config.ts",
    "typecheck": "node ../../app/node_modules/vue-tsc/bin/vue-tsc.js --noEmit -p tsconfig.json || node ../../app/node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test": "cd ../../app && node node_modules/vitest/vitest.mjs run spark-kanban"
  }
}
